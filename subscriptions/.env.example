# Copy to the repository root's ignored .env.subscriptions (chmod 600).
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_WORKER=rulesv2-subscriptions
SUBSCRIPTION_BASE_URL=https://rulesv2-subscriptions.YOUR_SUBDOMAIN.workers.dev
# Obtain the EXISTING token from the owner/secure backup. Never auto-regenerate it.
ANDROID_SUBSCRIPTION_TOKEN=EXISTING_ANDROID_TOKEN
IPHONE_SUBSCRIPTION_TOKEN=EXISTING_IPHONE_TOKEN
MACBOOK_SUBSCRIPTION_TOKEN=EXISTING_MACBOOK_TOKEN
# For a genuinely new device, omit its token and explicitly use --bootstrap.
# Separately store CLOUDFLARE_API_TOKEN in the root's ignored .env.cloudflare.
