# Destination rules that share an FlClash policy group, independent of GEOIP.
#
# Format: domain-suffix,<domain>,<group>
# Groups: 北美 | 游戏 | DIRECT | PROXY | REJECT | YouTube
#
# Source: docs/nekobox-route-snapshot.json
#   18     -> same exit as 北美app (Dmit-Beanfield-Paypal)
#   missav -> same exit as 游戏 (JPTY1-Game)
#   安全浏览 -> 绕过

domain-suffix,18comic.vip,北美
domain-suffix,hanime1.me,北美
domain-suffix,missav.ai,游戏
domain-suffix,missav.ws,游戏
domain-suffix,browsercrp.vivo.com.cn,DIRECT
